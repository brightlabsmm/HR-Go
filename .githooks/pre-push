#!/bin/sh
# Insert the next application patch version before git sends the push.
# Git has no database client. This script runs backend/cmd/bump-patch-version,
# which reads DATABASE_URL from the environment or backend/.env.
set -eu

updates=$(cat)
trimmed=$(printf '%s' "$updates" | tr -d '[:space:]')
if [ -z "$trimmed" ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root/backend"
if ! command -v go >/dev/null 2>&1; then
  echo "bump patch version: go is not on PATH" >&2
  exit 1
fi

# Keep the build cache inside the repo tmp dir. A Git Bash build left in the
# default user cache can produce a binary Windows refuses to start.
cache="$root/backend/tmp/gocache"
mkdir -p "$cache"
export GOCACHE="$cache"
export GOTMPDIR="$cache"

# Git's own hook process on Windows cannot launch the compiled Go binary.
# PowerShell can. Unix machines run go directly.
if command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -Command 'go run ./cmd/bump-patch-version; exit $LASTEXITCODE'
  exit $?
fi

go run ./cmd/bump-patch-version
